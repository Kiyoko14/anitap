# ─── Application ──────────────────────────────────────────────────────────────
APP_NAME=AniTap
DEBUG=false

# ─── Database (Supabase / PostgreSQL) ─────────────────────────────────────────
# Format: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=postgresql+asyncpg://postgres:your-password@db.xxxx.supabase.co:5432/postgres

# ─── Redis (Upstash) ──────────────────────────────────────────────────────────
# Format: rediss://:your-token@your-host.upstash.io:6380
REDIS_URL=rediss://:your-upstash-token@your-host.upstash.io:6380

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generate a secure random key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=changeme_generate_a_strong_secret_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080  # 7 days

# ─── Telegram ─────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token

# ─── Game Economy ─────────────────────────────────────────────────────────────
BASE_TAP=1
REFERRAL_BONUS_NEW_USER=1000
REFERRAL_BONUS_REFERRER=500
REFERRAL_PERCENT=0.05
MAX_TAPS_PER_SECOND=10

# ─── Performance ──────────────────────────────────────────────────────────────
FLUSH_INTERVAL=5         # seconds between Redis→DB buffer flushes
RATE_LIMIT_PER_MINUTE=300  # IP-based rate limit
